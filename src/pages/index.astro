---
import Layout from "../layouts/Layout.astro";
const year = new Date().getFullYear();
---

<Layout
  title="MERUS — Tratamento Físico de Fluidos para Oil & Gas"
  description="O anel MERUS previne incrustação, corrosão e biofouling em sistemas de fluido industrial e offshore. Sem químicos, sem paradas, sem alteração de processo. Fabricado na Alemanha."
>

  <!-- ── NAV ── -->
  <header class="nav" id="topo">
    <div class="nav-inner container">
      <a href="#topo" class="logo" aria-label="MERUS — página inicial">
        <img src="/merus-logo2.svg" alt="MERUS" width="100" height="48" />
        <span class="logo-sep" aria-hidden="true"></span>
        <img src="/gavea-green.png" alt="Gavea Green" class="logo-gavea" width="92" height="48" />
      </a>
      <nav class="nav-links" aria-label="Navegação principal">
        <a href="#solucao">Solução</a>
        <a href="#tecnologia">Tecnologia</a>
        <a href="#aplicacoes">Aplicações</a>
        <a href="#clientes">Clientes</a>
      </nav>
      <a href="#contato" class="btn-nav">Solicitar Avaliação</a>
    </div>
  </header>

  <!-- ── HERO + SOLUÇÃO (vídeo travado · scrub no scroll) ── -->
  <div class="video-stage" id="vstage">
    <div class="video-bg" aria-hidden="true">
      <video id="bgvideo" src="/video-merus-v3.mp4" muted playsinline preload="auto"></video>
    </div>

  <section id="hero" aria-labelledby="hero-titulo">
    <div class="container hero-inner">

      <div class="hero-texto">
        <p class="hero-market">Mercado Oil &amp; Gas</p>
        <p class="eyebrow">Fabricado na Alemanha &mdash; Oil &amp; Gas / Industrial</p>
        <h1 id="hero-titulo">Keeps your pipes clean.</h1>
        <p class="hero-sub">Tubos livres de incrustações</p>
        <p class="hero-corpo">
          Instalado externamente à tubulação, o MERUS Ring transmite oscilações
          físicas para a água, ajudando a reduzir depósitos, corrosão e biofilme no sistema.
        </p>
        <ul class="hero-bullets" role="list">
          <li>Menos manutenção.</li>
          <li>Mais eficiência.</li>
          <li>Maior vida útil.</li>
        </ul>
        <div class="mig-hero">
          <img src="/made-in-germany.png" alt="Made in Germany" width="110" height="44" loading="eager" />
        </div>
      </div>

    </div>
  </section>

  <!-- ── SOLUÇÃO ── -->
  <section id="solucao" aria-labelledby="sol-titulo">
    <div class="container">
      <div class="section-label">01 &mdash; Solução</div>
      <h2 id="sol-titulo">Menos impacto,<br>mais eficiência.</h2>
      <div class="sol-layout">
        <div class="sol-corpo">
          <p>
            Tecnologia alemã para tratamento de água, com alta eficiência
            operacional e menor impacto ambiental.
          </p>
        </div>
        <ul class="sol-bullets" role="list">
          <li>Sem químicos.</li>
          <li>Sem consumo de energia.</li>
          <li>Sem manutenção recorrente.</li>
          <li>ROI em poucos meses.</li>
          <li>05 anos de duração.</li>
        </ul>
      </div>
    </div>
  </section>
  </div><!-- /video-stage -->

  <!-- ── FAIXA DE INDICADORES ── -->
  <section class="faixa-stats" aria-label="Indicadores MERUS">
    <div class="container faixa-inner">
      <div class="faixa-item">
        <span class="faixa-n">70+</span>
        <span class="faixa-l">Países</span>
      </div>
      <span class="faixa-sep" aria-hidden="true"></span>
      <div class="faixa-item">
        <span class="faixa-n">30+</span>
        <span class="faixa-l">Anos em campo</span>
      </div>
      <span class="faixa-sep" aria-hidden="true"></span>
      <div class="faixa-item">
        <span class="faixa-n">0</span>
        <span class="faixa-l">Químicos adicionados</span>
      </div>
      <span class="faixa-sep" aria-hidden="true"></span>
      <div class="faixa-item">
        <span class="faixa-n">90%</span>
        <span class="faixa-l">Menos incrustações</span>
      </div>
    </div>
  </section>

  <!-- ── FAIXA CINEMATOGRÁFICA (anel instalado) ── -->
  <section class="cine-band" aria-label="MERUS Ring instalado em tubulação industrial">
    <div class="cine-band__inner container">
      <p class="cine-band__eyebrow">Instalação externa</p>
      <p class="cine-band__frase">Montado por fora da tubulação existente, sem corte, solda ou parada de operação.</p>
    </div>
  </section>

  <!-- ── TECNOLOGIA ── -->
  <section id="tecnologia" aria-labelledby="tec-titulo">
    <div class="container">

      <div class="tec-top">
        <div class="tec-texto">
          <div class="section-label">02 &mdash; A Tecnologia</div>
          <h2 id="tec-titulo">Como o MERUS funciona</h2>
          <p>
            O MERUS Ring é instalado ao redor da tubulação e transmite oscilações
            físicas para a água através da parede do tubo. Essas oscilações influenciam
            o comportamento das partículas no fluxo, contribuindo para maior solubilidade
            e evita a formação de depósitos.
          </p>
          <div class="tec-destaque">
            <strong>Instalação rápida, sem parar a operação</strong>
            <span>Instalado na infraestrutura existente, sem modificação de tubulação, soldagem ou penetração.</span>
          </div>
        </div>

        <figure class="tec-video">
          <video
            src="/merus-agua.mp4"
            autoplay loop muted playsinline preload="metadata"
          ></video>
        </figure>
      </div>

      <div class="data-callout" aria-label="Comparativo de taxa de corrosão em campo">
        <div class="data-grid">
          <div class="data-block">
            <span class="data-n">1.03</span>
            <span class="data-unit">MPY</span>
            <span class="data-label">Com MERUS</span>
            <span class="data-sub">Trocador 101-E9A</span>
          </div>
          <div class="data-vs" aria-hidden="true">vs</div>
          <div class="data-block data-block--ruim">
            <span class="data-n">2.87</span>
            <span class="data-unit">MPY</span>
            <span class="data-label">Sem MERUS</span>
            <span class="data-sub">Trocador 101-E9B</span>
          </div>
        </div>
        <p class="data-delta"><strong>64% menos</strong> corrosão no trocador tratado</p>
        <p class="data-mpy">
          <strong>MPY</strong> &mdash; Milésimos de polegada por ano: usado para indicar a taxa de
          corrosão em um tubo, sistema de tubulação ou outras superfícies metálicas.
        </p>
        <p class="data-note">
          Comparação lado a lado: trocadores 101-E9A (com MERUS) e 101-E9B (sem), na mesma
          plataforma, mesmo fluido e mesmo período de 3 meses de monitoramento de campo.
          A diferença medida é atribuível ao tratamento. Resultados refletem as condições da instalação monitorada.
        </p>
      </div>

    </div>
  </section>

  <!-- ── RESULTADOS (ANTES E DEPOIS) ── -->
  <section id="resultados" aria-labelledby="res-titulo" class="sec-cinza">
    <div class="container">
      <div class="section-label">03 &mdash; Antes e Depois</div>
      <h2 id="res-titulo">Menos incrustação.<br>Mais eficiência no fluxo.</h2>
      <p class="section-corpo">
        A atuação do MERUS contribui para superfícies internas mais limpas,
        evitando e melhorando a estabilidade operacional.
      </p>

      <div class="ba-grid">

        <div class="ba-card">
          <div class="ba" style="--pos:50%">
            <img class="ba-img" src="/heat-enchance-depois.png" alt="Trocador de calor após o MERUS: superfície mais limpa" loading="lazy" width="700" height="525" />
            <img class="ba-img ba-img--antes" src="/heat-enchance-antes.png" alt="Trocador de calor antes do MERUS: depósitos acumulados" loading="lazy" width="700" height="525" />
            <span class="ba-tag ba-tag--antes">Antes</span>
            <span class="ba-tag ba-tag--depois">Depois</span>
            <div class="ba-line" aria-hidden="true">
              <span class="ba-grip">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                  <path d="M6 4L2 8l4 4M10 4l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
            </div>
            <input class="ba-range" type="range" min="0" max="100" value="50" aria-label="Comparar antes e depois — trocador de calor" />
          </div>
          <div class="ba-legendas">
            <p><strong>Antes</strong> Depósitos acumulados e redução da passagem interna.</p>
            <p><strong>Depois</strong> Superfície mais limpa e melhor condição de fluxo.</p>
          </div>
        </div>

        <div class="ba-card">
          <div class="ba" style="--pos:50%">
            <img class="ba-img" src="/corrosao-depois.png" alt="Tubulação após o MERUS: menor acúmulo e corrosão" loading="lazy" width="700" height="525" />
            <img class="ba-img ba-img--antes" src="/corrosao-antes.png" alt="Tubulação antes do MERUS: corrosão e biofilme" loading="lazy" width="700" height="525" />
            <span class="ba-tag ba-tag--antes">Antes</span>
            <span class="ba-tag ba-tag--depois">Depois</span>
            <div class="ba-line" aria-hidden="true">
              <span class="ba-grip">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                  <path d="M6 4L2 8l4 4M10 4l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
            </div>
            <input class="ba-range" type="range" min="0" max="100" value="50" aria-label="Comparar antes e depois — corrosão e biofilme" />
          </div>
          <div class="ba-legendas">
            <p><strong>Antes</strong> Corrosão visível e formação de biofilme no sistema.</p>
            <p><strong>Depois</strong> Menor acúmulo, melhor estabilidade e manutenção reduzida.</p>
          </div>
        </div>

        <div class="ba-card">
          <div class="ba" style="--pos:50%">
            <img class="ba-img" src="/steam-boiler-depois.png" alt="Caldeira após o MERUS: superfície tratada" loading="lazy" width="700" height="525" />
            <img class="ba-img ba-img--antes" src="/steam-boiler-antes.png" alt="Caldeira antes do MERUS: incrustação na superfície" loading="lazy" width="700" height="525" />
            <span class="ba-tag ba-tag--antes">Antes</span>
            <span class="ba-tag ba-tag--depois">Depois</span>
            <div class="ba-line" aria-hidden="true">
              <span class="ba-grip">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                  <path d="M6 4L2 8l4 4M10 4l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
            </div>
            <input class="ba-range" type="range" min="0" max="100" value="50" aria-label="Comparar antes e depois — caldeira a vapor" />
          </div>
          <div class="ba-legendas">
            <p><strong>Antes</strong> Incrustação e perda de eficiência térmica.</p>
            <p><strong>Depois</strong> Superfície tratada e melhor desempenho operacional.</p>
          </div>
        </div>

      </div>

      <p class="res-micro">
        Resultados podem variar conforme fluido, material, histórico do sistema e condições operacionais.
      </p>
    </div>
  </section>

  <!-- ── FAIXA VERDE (quebra de cor · destaque) ── -->
  <section class="faixa-verde" aria-label="Destaque MERUS">
    <div class="container faixa-verde__inner">
      <p class="faixa-verde__frase">
        Mais do que tratar a água, o MERUS <strong>preserva a eficiência do sistema</strong>
        ao longo do tempo, sem químicos, sem paradas e sem alterar o processo.
      </p>
    </div>
  </section>

  <!-- ── APLICAÇÕES (Vessel / FPSO / Offshore) ── -->
  <section id="aplicacoes" class="aplic" aria-labelledby="ap-titulo">
    <div class="container">
      <p class="aplic-kicker">Onde o MERUS pode ser aplicado</p>
      <div class="aplic-head">
        <h2 id="ap-titulo">O seu ativo.<br>Os seus sistemas.</h2>
        <p class="aplic-lead">Embarcações, FPSOs e plataformas offshore compartilham desafios de circulação de fluidos. A aplicação começa pela identificação do circuito.</p>
      </div>

      <div class="aplic-grid">
        <article>
          <svg class="asset-diagram" viewBox="0 0 440 260" fill="none" aria-hidden="true"><defs><pattern id="grid-vessel" width="22" height="22" patternUnits="userSpaceOnUse"><path d="M22 0H0v22" stroke="#dce8e2" stroke-width=".5"/></pattern></defs><rect x="1" y="1" width="438" height="258" fill="url(#grid-vessel)"/><g stroke="#94b3a6" stroke-width="1.2"><path d="M28 220c10-5 20-5 30 0s20 5 30 0 20-5 30 0 20 5 30 0 20-5 30 0 20 5 30 0 20-5 30 0 20 5 30 0 20-5 30 0 20 5 30 0 20-5 30 0 20 5 30 0"/><path d="M28 234c10-5 20-5 30 0s20 5 30 0 20-5 30 0 20 5 30 0 20-5 30 0 20 5 30 0 20-5 30 0 20 5 30 0 20-5 30 0 20 5 30 0 20-5 30 0 20 5 30 0" opacity=".5"/></g><g stroke="#416e5c" stroke-width="1.7" stroke-linejoin="round"><path d="M44 168h342l-30 41H84l-40-41Z" fill="#e3eee8"/><path d="M64 168v-42h29v-33h73v75M75 125h96M96 93l9-18h48l13 18M115 75V49h6v26M93 140h73M194 166v-43h22v43M231 166v-43h22v43M268 166v-43h22v43M302 168v-18h62v18M175 132h119"/><path d="M110 106h10v11h-10zM134 106h10v11h-10zM98 150h8m16 0h8m16 0h8M58 184h307M178 184h113"/><path d="M339 150V80h5v70M344 92h28v8h-28M347 111l25-19M71 168v-15h19"/><path d="M98 207v6m34-6v6m178-6v6"/></g><path class="circuit" d="M68 180h100v-45h120v45h65" stroke="#009f4a" stroke-width="3" stroke-linecap="round"/><g fill="#fff" stroke="#007b3e" stroke-width="2"><circle cx="168" cy="135" r="5"/><circle cx="288" cy="180" r="5"/></g><g stroke="#a6bbb1" stroke-width=".8"><path d="M16 16h12m-6-6v12M412 16h12m-6-6v12M16 247h12m-6-6v12M412 247h12m-6-6v12"/></g></svg>
          <div class="aplic-card-head"><h3>Vessel</h3><span>Embarcações</span></div>
          <p>Circuitos de fluido a bordo, da geração de água ao resfriamento.</p>
        </article>
        <article>
          <svg class="asset-diagram" viewBox="0 0 440 260" fill="none" aria-hidden="true"><defs><pattern id="grid-fpso" width="22" height="22" patternUnits="userSpaceOnUse"><path d="M22 0H0v22" stroke="#dce8e2" stroke-width=".5"/></pattern></defs><rect x="1" y="1" width="438" height="258" fill="url(#grid-fpso)"/><g stroke="#94b3a6" stroke-width="1.2"><path d="M28 220c10-5 20-5 30 0s20 5 30 0 20-5 30 0 20 5 30 0 20-5 30 0 20 5 30 0 20-5 30 0 20 5 30 0 20-5 30 0 20 5 30 0 20-5 30 0 20 5 30 0"/><path d="M28 234c10-5 20-5 30 0s20 5 30 0 20-5 30 0 20 5 30 0 20-5 30 0 20 5 30 0 20-5 30 0 20 5 30 0 20-5 30 0 20 5 30 0 20-5 30 0 20 5 30 0" opacity=".5"/></g><g stroke="#416e5c" stroke-width="1.7" stroke-linejoin="round"><path d="M34 169h370l-38 41H69l-35-41Z" fill="#e3eee8"/><path d="M53 169v-43h58v43M66 125V96h35v29M73 96V74h8v22M52 143h59M62 133h7m12 0h7m12 0h7M53 184h336"/><path d="M123 169v-19c0-33 45-33 45 0v19m10 0v-19c0-33 45-33 45 0v19m10 0v-19c0-33 45-33 45 0v19M117 158h168M145 123v-13m55 13v-13m55 13v-13"/><path d="M305 169V95h31v74M300 95h41M308 95V74h25v21M312 74V45h8v29M310 116h21m-21 15h21m-21 15h21M352 169V86h9v83M348 86h17M356 86V52m0 0v-12m-7 12h14M340 158h47v11M70 201h281"/><path d="M325 66h55v8h-55M368 74l-13 12M85 206v9m237-9v9"/></g><path class="circuit" d="M68 180h100v-45h120v45h65" stroke="#009f4a" stroke-width="3" stroke-linecap="round"/><g fill="#fff" stroke="#007b3e" stroke-width="2"><circle cx="168" cy="135" r="5"/><circle cx="288" cy="180" r="5"/></g><g stroke="#a6bbb1" stroke-width=".8"><path d="M16 16h12m-6-6v12M412 16h12m-6-6v12M16 247h12m-6-6v12M412 247h12m-6-6v12"/></g></svg>
          <div class="aplic-card-head"><h3>FPSO</h3><span>Unidades flutuantes</span></div>
          <p>Sistemas de utilidades e infraestrutura de processamento offshore.</p>
        </article>
        <article>
          <svg class="asset-diagram" viewBox="0 0 440 260" fill="none" aria-hidden="true"><defs><pattern id="grid-platform" width="22" height="22" patternUnits="userSpaceOnUse"><path d="M22 0H0v22" stroke="#dce8e2" stroke-width=".5"/></pattern></defs><rect x="1" y="1" width="438" height="258" fill="url(#grid-platform)"/><g stroke="#94b3a6" stroke-width="1.2"><path d="M28 220c10-5 20-5 30 0s20 5 30 0 20-5 30 0 20 5 30 0 20-5 30 0 20 5 30 0 20-5 30 0 20 5 30 0 20-5 30 0 20 5 30 0 20-5 30 0 20 5 30 0"/><path d="M28 234c10-5 20-5 30 0s20 5 30 0 20-5 30 0 20 5 30 0 20-5 30 0 20 5 30 0 20-5 30 0 20 5 30 0 20-5 30 0 20 5 30 0 20-5 30 0 20 5 30 0" opacity=".5"/></g><g stroke="#416e5c" stroke-width="1.7" stroke-linejoin="round"><path d="M82 140h283v41H82z" fill="#e3eee8"/><path d="M98 181v34h28v-34m190 0v34h28v-34M91 163h267M81 139h-15v-12h308v12h-9M101 127v-28h53v28m-41-28V78h25v21M92 150h18v8H92m31-8h18v8h-18m31-8h18v8h-18M116 181l-10 30m26-30-8 30m198-30 12 30m-30-30 10 30"/><path d="M206 127l13-100h27l13 100M219 27h27M217 44h31M215 61h35M213 78h39M210 98h44M219 44l31 17m-35 0 37 17m-39 0 41 20m-44 0 48 25M248 44l-33 17m35 0-37 17m39 0-42 20m44 0-47 25"/><path d="M287 127V97h18v30M296 97V53m0 0-84-21-4 8 87 25M277 97l18-32M309 107h62v20M314 107v-9h52v9M153 127V69h8v58M151 69h12"/><path d="M83 168l33 12m248-12-35 12M199 181v34M266 181v34"/></g><path class="circuit" d="M92 151h72v-29h111v29h76" stroke="#009f4a" stroke-width="3" stroke-linecap="round"/><g fill="#fff" stroke="#007b3e" stroke-width="2"><circle cx="164" cy="122" r="5"/><circle cx="275" cy="151" r="5"/></g><g stroke="#a6bbb1" stroke-width=".8"><path d="M16 16h12m-6-6v12M412 16h12m-6-6v12M16 247h12m-6-6v12M412 247h12m-6-6v12"/></g></svg>
          <div class="aplic-card-head"><h3>Offshore Platform</h3><span>Plataformas offshore</span></div>
          <p>Equipamentos e circuitos em instalações de operação no mar.</p>
        </article>
      </div>

      <div class="aplic-list">
        <div>
          <h3>Aplicações usuais</h3>
          <p>O ponto de instalação e a adequação de cada sistema fazem parte da avaliação técnica.</p>
          <a class="aplic-cta" href="#contato">Avaliar minha aplicação
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
        </div>
        <ul role="list">
          <li><svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="m3 8 3 3 7-7" stroke="currentColor" stroke-width="1.4"/></svg>Trocadores de calor (placa, casco e tubo)</li>
          <li><svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="m3 8 3 3 7-7" stroke="currentColor" stroke-width="1.4"/></svg>Circuitos de resfriamento</li>
          <li><svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="m3 8 3 3 7-7" stroke="currentColor" stroke-width="1.4"/></svg>Plantas de dessalinização</li>
          <li><svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="m3 8 3 3 7-7" stroke="currentColor" stroke-width="1.4"/></svg>Geradores de água doce (FWG)</li>
          <li><svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="m3 8 3 3 7-7" stroke="currentColor" stroke-width="1.4"/></svg>Caixas de mar</li>
          <li><svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="m3 8 3 3 7-7" stroke="currentColor" stroke-width="1.4"/></svg>Tanques de lastro</li>
          <li><svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="m3 8 3 3 7-7" stroke="currentColor" stroke-width="1.4"/></svg>Sistemas de pressurização (hidróforos)</li>
          <li><svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="m3 8 3 3 7-7" stroke="currentColor" stroke-width="1.4"/></svg>Sistema sanitário a vácuo</li>
          <li><svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="m3 8 3 3 7-7" stroke="currentColor" stroke-width="1.4"/></svg>Sistema de interligação (crossover)</li>
          <li><svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="m3 8 3 3 7-7" stroke="currentColor" stroke-width="1.4"/></svg>Linhas de alimentação (bombordo e boreste)</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- ── CASE: ARABIA I ── -->
  <section id="case-arabia" aria-labelledby="case-titulo" class="sec-cinza">
    <div class="case-media" aria-hidden="true">
      <video src="/arabia-i.mp4" autoplay loop muted playsinline preload="metadata"></video>
    </div>
    <div class="container case-inner">
      <div class="case-texto">
        <div class="section-label">05 &mdash; Em Operação</div>
        <h2 id="case-titulo">Cliente internacional<br>em operação no Brasil</h2>
        <p class="case-sub">Jackup &middot; Borr Drilling &middot; Arabia I</p>
        <p class="case-contrato">Contrato Petrobras</p>

