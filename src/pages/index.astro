---
import Layout from "../layouts/Layout.astro";
const year = new Date().getFullYear();
---

<Layout
  title="MERUS — Tratamento Físico de Fluidos para Oil & Gas"
  description="O anel MERUS previne incrustação, corrosão e biofouling em sistemas de fluido industrial e offshore. Sem químicos, sem paradas, sem alteração de processo. Fabricado na Alemanha."
>

  <!-- ── NAV ── -->
  <header class="nav" id="topo">
    <div class="nav-inner container">
      <a href="#topo" class="logo" aria-label="MERUS — página inicial">
        <img src="/merus-logo2.svg" alt="MERUS" width="100" height="48" />
        <span class="logo-sep" aria-hidden="true"></span>
        <img src="/gavea-green.png" alt="Gavea Green" class="logo-gavea" width="92" height="48" />
      </a>
      <nav class="nav-links" aria-label="Navegação principal">
        <a href="#solucao">Solução</a>
        <a href="#tecnologia">Tecnologia</a>
        <a href="#aplicacoes">Aplicações</a>
        <a href="#clientes">Clientes</a>
      </nav>
      <a href="#contato" class="btn-nav">Solicitar Avaliação</a>
    </div>
  </header>

  <!-- ── HERO + SOLUÇÃO (vídeo travado · scrub no scroll) ── -->
  <div class="video-stage" id="vstage">
    <div class="video-bg" aria-hidden="true">
      <video id="bgvideo" src="/video-merus-v3.mp4" muted playsinline preload="auto"></video>
    </div>

  <section id="hero" aria-labelledby="hero-titulo">
    <div class="container hero-inner">

      <div class="hero-texto">
        <p class="hero-market">Mercado Oil &amp; Gas</p>
        <p class="eyebrow">Fabricado na Alemanha &mdash; Oil &amp; Gas / Industrial</p>
        <h1 id="hero-titulo">Keeps your pipes clean.</h1>
        <p class="hero-sub">Tubos livres de incrustações</p>
        <p class="hero-corpo">
          Instalado externamente à tubulação, o MERUS Ring transmite oscilações
          físicas para a água, ajudando a reduzir depósitos, corrosão e biofilme no sistema.
        </p>
        <ul class="hero-bullets" role="list">
          <li>Menos manutenção.</li>
          <li>Mais eficiência.</li>
          <li>Maior vida útil.</li>
        </ul>
        <div class="mig-hero">
          <img src="/made-in-germany.png" alt="Made in Germany" width="110" height="44" loading="eager" />
        </div>
      </div>

    </div>
  </section>

  <!-- ── SOLUÇÃO ── -->
  <section id="solucao" aria-labelledby="sol-titulo">
    <div class="container">
      <div class="section-label">01 &mdash; Solução</div>
      <h2 id="sol-titulo">Menos impacto,<br>mais eficiência.</h2>
      <div class="sol-layout">
        <div class="sol-corpo">
          <p>
            Tecnologia alemã para tratamento de água, com alta eficiência
            operacional e menor impacto ambiental.
          </p>
        </div>
        <ul class="sol-bullets" role="list">
          <li>Sem químicos.</li>
          <li>Sem consumo de energia.</li>
          <li>Sem manutenção recorrente.</li>
          <li>ROI em poucos meses.</li>
          <li>05 anos de duração.</li>
        </ul>
      </div>
    </div>
  </section>
  </div><!-- /video-stage -->

  <!-- ── FAIXA DE INDICADORES ── -->
  <section class="faixa-stats" aria-label="Indicadores MERUS">
    <div class="container faixa-inner">
      <div class="faixa-item">
        <span class="faixa-n">70+</span>
        <span class="faixa-l">Países</span>
      </div>
      <span class="faixa-sep" aria-hidden="true"></span>
      <div class="faixa-item">
        <span class="faixa-n">30+</span>
        <span class="faixa-l">Anos em campo</span>
      </div>
      <span class="faixa-sep" aria-hidden="true"></span>
      <div class="faixa-item">
        <span class="faixa-n">0</span>
        <span class="faixa-l">Químicos adicionados</span>
      </div>
      <span class="faixa-sep" aria-hidden="true"></span>
      <div class="faixa-item">
        <span class="faixa-n">90%</span>
        <span class="faixa-l">Menos incrustações</span>
      </div>
    </div>
  </section>

  <!-- ── FAIXA CINEMATOGRÁFICA (anel instalado) ── -->
  <section class="cine-band" aria-label="MERUS Ring instalado em tubulação industrial">
    <div class="cine-band__inner container">
      <p class="cine-band__eyebrow">Instalação externa</p>
      <p class="cine-band__frase">Montado por fora da tubulação existente, sem corte, solda ou parada de operação.</p>
    </div>
  </section>

  <!-- ── TECNOLOGIA ── -->
  <section id="tecnologia" aria-labelledby="tec-titulo">
    <div class="container">

      <div class="tec-top">
        <div class="tec-texto">
          <div class="section-label">02 &mdash; A Tecnologia</div>
          <h2 id="tec-titulo">Como o MERUS funciona</h2>
          <p>
            O MERUS Ring é instalado ao redor da tubulação e transmite oscilações
            físicas para a água através da parede do tubo. Essas oscilações influenciam
            o comportamento das partículas no fluxo, contribuindo para maior solubilidade
            e evita a formação de depósitos.
          </p>
          <div class="tec-destaque">
            <strong>Instalação rápida, sem parar a operação</strong>
            <span>Instalado na infraestrutura existente, sem modificação de tubulação, soldagem ou penetração.</span>
          </div>
        </div>

        <figure class="tec-video">
          <video
            src="/merus-agua.mp4"
            autoplay loop muted playsinline preload="metadata"
          ></video>
        </figure>
      </div>

      <div class="data-callout" aria-label="Comparativo de taxa de corrosão em campo">
        <div class="data-grid">
          <div class="data-block">
            <span class="data-n">1.03</span>
            <span class="data-unit">MPY</span>
            <span class="data-label">Com MERUS</span>
            <span class="data-sub">Trocador 101-E9A</span>
          </div>
          <div class="data-vs" aria-hidden="true">vs</div>
          <div class="data-block data-block--ruim">
            <span class="data-n">2.87</span>
            <span class="data-unit">MPY</span>
            <span class="data-label">Sem MERUS</span>
            <span class="data-sub">Trocador 101-E9B</span>
          </div>
        </div>
        <p class="data-delta"><strong>64% menos</strong> corrosão no trocador tratado</p>
        <p class="data-mpy">
          <strong>MPY</strong> &mdash; Milésimos de polegada por ano: usado para indicar a taxa de
          corrosão em um tubo, sistema de tubulação ou outras superfícies metálicas.
        </p>
        <p class="data-note">
          Comparação lado a lado: trocadores 101-E9A (com MERUS) e 101-E9B (sem), na mesma
          plataforma, mesmo fluido e mesmo período de 3 meses de monitoramento de campo.
          A diferença medida é atribuível ao tratamento. Resultados refletem as condições da instalação monitorada.
        </p>
      </div>

    </div>
  </section>

  <!-- ── RESULTADOS (ANTES E DEPOIS) ── -->
  <section id="resultados" aria-labelledby="res-titulo" class="sec-cinza">
    <div class="container">
      <div class="section-label">03 &mdash; Antes e Depois</div>
      <h2 id="res-titulo">Menos incrustação.<br>Mais eficiência no fluxo.</h2>
      <p class="section-corpo">
        A atuação do MERUS contribui para superfícies internas mais limpas,
        evitando e melhorando a estabilidade operacional.
      </p>

      <div class="ba-grid">

        <div class="ba-card">
          <div class="ba" style="--pos:50%">
            <img class="ba-img" src="/heat-enchance-depois.png" alt="Trocador de calor após o MERUS: superfície mais limpa" loading="lazy" width="700" height="525" />
            <img class="ba-img ba-img--antes" src="/heat-enchance-antes.png" alt="Trocador de calor antes do MERUS: depósitos acumulados" loading="lazy" width="700" height="525" />
            <span class="ba-tag ba-tag--antes">Antes</span>
            <span class="ba-tag ba-tag--depois">Depois</span>
            <div class="ba-line" aria-hidden="true">
              <span class="ba-grip">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                  <path d="M6 4L2 8l4 4M10 4l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
            </div>
            <input class="ba-range" type="range" min="0" max="100" value="50" aria-label="Comparar antes e depois — trocador de calor" />
          </div>
          <div class="ba-legendas">
            <p><strong>Antes</strong> Depósitos acumulados e redução da passagem interna.</p>
            <p><strong>Depois</strong> Superfície mais limpa e melhor condição de fluxo.</p>
          </div>
        </div>

        <div class="ba-card">
          <div class="ba" style="--pos:50%">
            <img class="ba-img" src="/corrosao-depois.png" alt="Tubulação após o MERUS: menor acúmulo e corrosão" loading="lazy" width="700" height="525" />
            <img class="ba-img ba-img--antes" src="/corrosao-antes.png" alt="Tubulação antes do MERUS: corrosão e biofilme" loading="lazy" width="700" height="525" />
            <span class="ba-tag ba-tag--antes">Antes</span>
            <span class="ba-tag ba-tag--depois">Depois</span>
            <div class="ba-line" aria-hidden="true">
              <span class="ba-grip">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                  <path d="M6 4L2 8l4 4M10 4l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
            </div>
            <input class="ba-range" type="range" min="0" max="100" value="50" aria-label="Comparar antes e depois — corrosão e biofilme" />
          </div>
          <div class="ba-legendas">
            <p><strong>Antes</strong> Corrosão visível e formação de biofilme no sistema.</p>
            <p><strong>Depois</strong> Menor acúmulo, melhor estabilidade e manutenção reduzida.</p>
          </div>
        </div>

        <div class="ba-card">
          <div class="ba" style="--pos:50%">
            <img class="ba-img" src="/steam-boiler-depois.png" alt="Caldeira após o MERUS: superfície tratada" loading="lazy" width="700" height="525" />
            <img class="ba-img ba-img--antes" src="/steam-boiler-antes.png" alt="Caldeira antes do MERUS: incrustação na superfície" loading="lazy" width="700" height="525" />
            <span class="ba-tag ba-tag--antes">Antes</span>
            <span class="ba-tag ba-tag--depois">Depois</span>
            <div class="ba-line" aria-hidden="true">
              <span class="ba-grip">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                  <path d="M6 4L2 8l4 4M10 4l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
            </div>
            <input class="ba-range" type="range" min="0" max="100" value="50" aria-label="Comparar antes e depois — caldeira a vapor" />
          </div>
          <div class="ba-legendas">
            <p><strong>Antes</strong> Incrustação e perda de eficiência térmica.</p>
            <p><strong>Depois</strong> Superfície tratada e melhor desempenho operacional.</p>
          </div>
        </div>

      </div>

      <p class="res-micro">
        Resultados podem variar conforme fluido, material, histórico do sistema e condições operacionais.
      </p>
    </div>
  </section>

  <!-- ── FAIXA VERDE (quebra de cor · destaque) ── -->
  <section class="faixa-verde" aria-label="Destaque MERUS">
    <div class="container faixa-verde__inner">
      <p class="faixa-verde__frase">
        Mais do que tratar a água, o MERUS <strong>preserva a eficiência do sistema</strong>
        ao longo do tempo, sem químicos, sem paradas e sem alterar o processo.
      </p>
    </div>
  </section>

  <!-- ── APLICAÇÕES ── -->
  <section id="aplicacoes" aria-labelledby="ap-titulo">
    <div class="container">
      <div class="section-label">04 &mdash; Aplicações</div>
      <h2 id="ap-titulo">
        Aplicado em infraestrutura<br>crítica de Oil &amp; Gas.
      </h2>
      <p class="section-corpo">
        O MERUS atua no nível de componente e sistema, endereçando problemas de
        qualidade de fluidos em toda a cadeia de produção e processamento.
      </p>
      <div class="apps-assets" role="list">
        <figure class="apps-asset" role="listitem">
          <img src="/merus-vessel.png" alt="Embarcação / navio" loading="lazy" width="885" height="474" />
          <figcaption>Embarcações</figcaption>
        </figure>
        <figure class="apps-asset" role="listitem">
          <img src="/merus-fpso.png" alt="FPSO" loading="lazy" width="983" height="540" />
          <figcaption>FPSOs</figcaption>
        </figure>
        <figure class="apps-asset" role="listitem">
          <img src="/merus-platform.png" alt="Plataforma offshore" loading="lazy" width="517" height="608" />
          <figcaption>Plataformas Offshore</figcaption>
        </figure>
      </div>

      <ul class="apps-lista" role="list">
        <li>Trocadores de calor (placa, casco e tubo)</li>
        <li>Circuitos de resfriamento</li>
        <li>Plantas de dessalinização</li>
        <li>Geradores de água doce (FWG)</li>
        <li>Caixas de mar</li>
        <li>Tanques de lastro</li>
        <li>Sistemas de pressurização (hidróforos)</li>
        <li>Sistema sanitário a vácuo</li>
        <li>Sistema de interligação (crossover)</li>
        <li>Linhas de alimentação (bombordo e boreste)</li>
      </ul>

      <p class="apps-tag">Aplicável em embarcações, FPSOs e plataformas offshore.</p>
    </div>
  </section>

  <!-- ── CASE: ARABIA I ── -->
  <section id="case-arabia" aria-labelledby="case-titulo" class="sec-cinza">
    <div class="case-media" aria-hidden="true">
      <video src="/arabia-i.mp4" autoplay loop muted playsinline preload="metadata"></video>
    </div>
    <div class="container case-inner">
      <div class="case-texto">
        <div class="section-label">05 &mdash; Em Operação</div>
        <h2 id="case-titulo">Cliente internacional<br>em operação no Brasil</h2>
        <p class="case-sub">Jackup &middot; Borr Drilling &middot; Arabia I</p>
        <p class="case-contrato">Contrato Petrobras</p>

        <ul class="case-specs" role="list">
          <li><span class="spec-nome">Deep well risers</span><span class="spec-tag">MERUS Chain</span></li>
          <li><span class="spec-nome">Raw water pump</span><span class="spec-tag">MERUS Chain</span></li>
          <li><span class="spec-nome">Brake resistors</span><span class="spec-tag">MERUS Ring</span></li>
          <li><span class="spec-nome">Engine inlet</span><span class="spec-tag">MERUS Ring</span></li>
          <li><span class="spec-nome">Compressors</span><span class="spec-tag">MERUS Ring</span></li>
          <li><span class="spec-nome">Main chiller unit</span><span class="spec-tag">MERUS Ring</span></li>
          <li><span class="spec-nome">Fire fighting lines</span><span class="spec-tag">MERUS Ring</span></li>
        </ul>
      </div>
    </div>
  </section>

  <!-- ── CLIENTES ── -->
  <section id="clientes" aria-labelledby="cl-titulo">
    <div class="container">
      <div class="section-label">06 &mdash; Histórico em Campo</div>
      <h2 id="cl-titulo">
        Validado por operadoras<br>que não aceitam promessas.
      </h2>
      <p class="section-corpo">
        Mais de 30 anos de instalações documentadas em plataformas offshore, FPSOs,
        refinarias e plantas industriais.
      </p>

      <div class="logos-marquee" aria-label="Operadoras que utilizam MERUS">
        <div class="logos-viewport">
          <div class="logos-group">
            <img src="/logos/aramco.png" alt="Saudi Aramco" loading="lazy" />
            <img src="/logos/adnoc.png" alt="ADNOC" loading="lazy" />
            <img src="/logos/shell.png" alt="Shell" loading="lazy" />
            <img src="/logos/transocean.png" alt="Transocean" loading="lazy" />
            <img src="/logos/wintershall.png" alt="Wintershall" loading="lazy" />
            <img src="/logos/pertamina.png" alt="Pertamina" loading="lazy" />
            <img src="/logos/subsea7.png" alt="Subsea7" loading="lazy" />
            <img src="/logos/cbo.png" alt="Grupo CBO" loading="lazy" />
            <img src="/logos/oceanpact.png" alt="OceanPact" loading="lazy" />
            <img src="/logos/foresea.png" alt="Foresea" loading="lazy" />
            <img src="/logos/tranship.png" alt="Tranship" loading="lazy" />
            <img src="/logos/eletronuclear.png" alt="Eletronuclear" loading="lazy" />
            <img src="/logos/b-braun.png" alt="B. Braun" loading="lazy" />
          </div>
          <div class="logos-group" aria-hidden="true">
            <img src="/logos/aramco.png" alt="" loading="lazy" />
            <img src="/logos/adnoc.png" alt="" loading="lazy" />
            <img src="/logos/shell.png" alt="" loading="lazy" />
            <img src="/logos/transocean.png" alt="" loading="lazy" />
            <img src="/logos/wintershall.png" alt="" loading="lazy" />
            <img src="/logos/pertamina.png" alt="" loading="lazy" />
            <img src="/logos/subsea7.png" alt="" loading="lazy" />
            <img src="/logos/cbo.png" alt="" loading="lazy" />
            <img src="/logos/oceanpact.png" alt="" loading="lazy" />
            <img src="/logos/foresea.png" alt="" loading="lazy" />
            <img src="/logos/tranship.png" alt="" loading="lazy" />
            <img src="/logos/eletronuclear.png" alt="" loading="lazy" />
            <img src="/logos/b-braun.png" alt="" loading="lazy" />
          </div>
        </div>
      </div>

      <p class="cl-nota">
        Referências disponíveis mediante solicitação sob NDA. Dados de campo e relatórios
        de inspeção compartilhados durante avaliação técnica.
      </p>
    </div>
  </section>

  <!-- ── FAIXA DE MARCA (vídeo aéreo Gávea) ── -->
  <section class="brand-band" aria-label="Gávea Green">
    <video class="brand-band__video" src="/gavea-aerial.mp4" poster="/gavea-aerial-poster.jpg" autoplay loop muted playsinline preload="none" aria-hidden="true"></video>
    <div class="brand-band__scrim" aria-hidden="true"></div>
    <div class="container brand-band__inner">
      <p class="brand-band__eyebrow">Gávea Green</p>
      <p class="brand-band__frase">Energia que transforma o futuro.</p>
      <p class="brand-band__sub">Tecnologia MERUS para operações de Oil &amp; Gas mais limpas, eficientes e duradouras.</p>
    </div>
  </section>

  <!-- ── CONTATO ── -->
  <section id="contato" aria-labelledby="ct-titulo">
    <div class="container contato-grid">
      <div class="contato-intro">
        <div class="section-label">07 &mdash; Contato</div>
        <h2 id="ct-titulo">Avalie o MERUS<br>na sua operação.</h2>
        <p class="section-corpo">
          Conte seu desafio com incrustação, corrosão ou biofilme. A equipe da
          Gavea Green retorna com uma avaliação técnica para o seu sistema.
        </p>
        <ul class="contato-info" role="list">
          <li>
            <span>E-mail</span>
            <a href="mailto:leo.moteff@gaveagroup.com">leo.moteff@gaveagroup.com</a>
          </li>
          <li>
            <span>Mercado</span>
            Oil &amp; Gas, offshore e industrial
          </li>
        </ul>
      </div>

      <form class="contato-form" action="https://formsubmit.co/leo.moteff@gaveagroup.com" method="POST">
        <input type="hidden" name="_subject" value="Nova avaliação técnica — site MERUS / Gavea Green" />
        <input type="hidden" name="_template" value="table" />
        <input type="hidden" name="_captcha" value="false" />
        <input type="text" name="_honey" class="contato-hp" tabindex="-1" autocomplete="off" aria-hidden="true" />

        <div class="campo">
          <label for="c-nome">Nome *</label>
          <input id="c-nome" name="Nome" type="text" required autocomplete="name" />
        </div>
        <div class="campo">
          <label for="c-empresa">Empresa</label>
          <input id="c-empresa" name="Empresa" type="text" autocomplete="organization" />
        </div>
        <div class="campo-linha">
          <div class="campo">
            <label for="c-email">E-mail *</label>
            <input id="c-email" name="E-mail" type="email" required autocomplete="email" />
          </div>
          <div class="campo">
            <label for="c-tel">Telefone</label>
            <input id="c-tel" name="Telefone" type="tel" autocomplete="tel" />
          </div>
        </div>
        <div class="campo">
          <label for="c-msg">Como podemos ajudar?</label>
          <textarea id="c-msg" name="Mensagem" rows="4"></textarea>
        </div>
        <button type="submit" class="btn-primario contato-enviar">
          Solicitar avaliação técnica
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
        <p class="contato-nota">Seus dados são usados apenas para esta avaliação técnica.</p>
      </form>
    </div>
  </section>

  <!-- ── FOOTER ── -->
  <footer class="footer">
    <div class="container footer-inner">
      <div class="footer-brand">
        <div class="footer-logos">
          <img src="/gavea-green-bco.png" alt="Gavea Green" class="footer-logo-gavea" />
        </div>
        <p>Tratamento físico de fluidos.<br>Fabricado na Alemanha desde 1995.</p>
      </div>
      <nav class="footer-links" aria-label="Navegação do rodapé">
        <a href="#solucao">Solução</a>
        <a href="#tecnologia">Tecnologia</a>
        <a href="#aplicacoes">Aplicações</a>
        <a href="#clientes">Clientes</a>
      </nav>
      <div class="footer-legal">
        <p>&copy; {year} Gavea Green &mdash; Tratamento físico de fluidos para Oil &amp; Gas.</p>
      </div>
    </div>
  </footer>

  <!-- Vídeo travado: scrub 1:1 no scroll (frente ao descer, reverse ao subir) -->
  <script is:inline>
    (function () {
      var stage = document.getElementById('vstage');
      var video = document.getElementById('bgvideo');
      if (!stage || !video) return;

      var prefersReduced =
        window.matchMedia &&
        window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      var duration = 0;
      var ticking = false;

      function update() {
        ticking = false;
        if (!duration) return;
        var rect = stage.getBoundingClientRect();
        var total = stage.offsetHeight - window.innerHeight;
        if (total <= 0) return;
        var progress = Math.min(1, Math.max(0, -rect.top / total));
        var t = progress * duration;
        if (Math.abs(video.currentTime - t) > 1 / 60) {
          try { video.currentTime = t; } catch (e) {}
        }
      }

      function onScroll() {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(update);
        }
      }

      function ready() {
        duration = video.duration || 0;
        update();
        if (prefersReduced) { video.pause(); return; }
        window.addEventListener('scroll', onScroll, { passive: true });
        window.addEventListener('resize', onScroll, { passive: true });
      }

      // iOS/Safari não renderiza o frame de um vídeo pausado que nunca "tocou".
      // Damos um play mudo (permitido em muted+playsinline) e pausamos em seguida
      // para fixar o primeiro frame — assim o scrub aparece também no mobile.
      function prime() {
        var p;
        try { p = video.play(); } catch (e) {}
        if (p && typeof p.then === 'function') {
          p.then(function () { video.pause(); ready(); })
           .catch(function () { video.pause(); ready(); });
        } else {
          video.pause();
          ready();
        }
      }

      if (video.readyState >= 1) {
        prime();
      } else {
        video.addEventListener('loadedmetadata', prime, { once: true });
      }

      // Fallback: se o autoplay mudo for bloqueado, prima o vídeo no primeiro toque.
      window.addEventListener('touchstart', function primeOnce() {
        window.removeEventListener('touchstart', primeOnce);
        var p;
        try { p = video.play(); } catch (e) {}
        if (p && typeof p.then === 'function') {
          p.then(function () { video.pause(); update(); }).catch(function () {});
        }
      }, { passive: true });
    })();
  </script>

  <!-- Slider comparativo antes/depois -->
  <script is:inline>
    (function () {
      var sliders = document.querySelectorAll('.ba-range');
      for (var i = 0; i < sliders.length; i++) {
        (function (range) {
          var ba = range.closest('.ba');
          if (!ba) return;
          function update() { ba.style.setProperty('--pos', range.value + '%'); }
          range.addEventListener('input', update);
          update();
        })(sliders[i]);
      }
    })();
  </script>

  <!-- Slider de aplicações: arrastar para rolar -->
  <script is:inline>
    (function () {
      var slider = document.getElementById('apps-slider');
      if (!slider) return;
      var down = false, moved = false, startX = 0, startLeft = 0;

      slider.addEventListener('pointerdown', function (e) {
        if (e.pointerType === 'mouse' && e.button !== 0) return;
        if (e.pointerType !== 'mouse') return; // toque usa scroll nativo
        down = true; moved = false;
        startX = e.clientX; startLeft = slider.scrollLeft;
        slider.classList.add('is-dragging');
        try { slider.setPointerCapture(e.pointerId); } catch (err) {}
      });

      slider.addEventListener('pointermove', function (e) {
        if (!down) return;
        var dx = e.clientX - startX;
        if (Math.abs(dx) > 4) moved = true;
        slider.scrollLeft = startLeft - dx;
      });

      function end(e) {
        if (!down) return;
        down = false;
        slider.classList.remove('is-dragging');
        try { slider.releasePointerCapture(e.pointerId); } catch (err) {}
      }
      slider.addEventListener('pointerup', end);
      slider.addEventListener('pointercancel', end);

      // evita que o clique no botão dispare logo após um arraste
      slider.addEventListener('click', function (e) {
        if (moved) { e.preventDefault(); e.stopPropagation(); moved = false; }
      }, true);

      // roda do mouse vertical -> rola na horizontal
      slider.addEventListener('wheel', function (e) {
        if (Math.abs(e.deltaY) > Math.abs(e.deltaX)) {
          slider.scrollLeft += e.deltaY;
          e.preventDefault();
        }
      }, { passive: false });
    })();
  </script>

  <!-- Contadores animados: indicadores (+70, 30+, 90%) e tabela MPY (1.03 / 2.87) -->
  <script is:inline>
    (function () {
      if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      if (!('IntersectionObserver' in window)) return;
      function animate(el) {
        var raw = el.textContent.trim();
        var m = raw.match(/^([\d]+(?:[.,][\d]+)?)(.*)$/);
        if (!m) return;
        var numStr = m[1].replace(',', '.'), suffix = m[2];
        var target = parseFloat(numStr);
        var decimals = (numStr.split('.')[1] || '').length;
        var dur = 1300, start = null;
        function fmt(v) { return decimals ? v.toFixed(decimals) : String(Math.round(v)); }
        function step(ts) {
          if (!start) start = ts;
          var p = Math.min(1, (ts - start) / dur);
          var e = 1 - Math.pow(1 - p, 3);
          el.textContent = fmt(e * target) + suffix;
          if (p < 1) requestAnimationFrame(step);
        }
        el.textContent = fmt(0) + suffix;
        requestAnimationFrame(step);
      }
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (en) {
          if (en.isIntersecting) { io.unobserve(en.target); animate(en.target); }
        });
      }, { threshold: 0.6 });
      document.querySelectorAll('.faixa-n, .data-n').forEach(function (n) { io.observe(n); });
    })();
  </script>

</Layout>
