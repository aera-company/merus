  <!-- Vídeo travado: scrub 1:1 no scroll (frente ao descer, reverse ao subir) -->
  <script is:inline>
    (function () {
      var stage = document.getElementById('vstage');
      var video = document.getElementById('bgvideo');
      if (!stage || !video) return;

      var prefersReduced =
        window.matchMedia &&
        window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      var duration = 0;
      var ticking = false;

      function update() {
        ticking = false;
        if (!duration) return;
        var rect = stage.getBoundingClientRect();
        var total = stage.offsetHeight - window.innerHeight;
        if (total <= 0) return;
        var progress = Math.min(1, Math.max(0, -rect.top / total));
        var t = progress * duration;
        if (Math.abs(video.currentTime - t) > 1 / 60) {
          try { video.currentTime = t; } catch (e) {}
        }
      }

      function onScroll() {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(update);
        }
      }

      function ready() {
        duration = video.duration || 0;
        update();
        if (prefersReduced) { video.pause(); return; }
        window.addEventListener('scroll', onScroll, { passive: true });
        window.addEventListener('resize', onScroll, { passive: true });
      }

      // iOS/Safari não renderiza o frame de um vídeo pausado que nunca "tocou".
      // Damos um play mudo (permitido em muted+playsinline) e pausamos em seguida
      // para fixar o primeiro frame — assim o scrub aparece também no mobile.
      function prime() {
        var p;
        try { p = video.play(); } catch (e) {}
        if (p && typeof p.then === 'function') {
          p.then(function () { video.pause(); ready(); })
           .catch(function () { video.pause(); ready(); });
        } else {
          video.pause();
          ready();
        }
      }

      if (video.readyState >= 1) {
        prime();
      } else {
        video.addEventListener('loadedmetadata', prime, { once: true });
      }

      // Fallback: se o autoplay mudo for bloqueado, prima o vídeo no primeiro toque.
      window.addEventListener('touchstart', function primeOnce() {
        window.removeEventListener('touchstart', primeOnce);
        var p;
        try { p = video.play(); } catch (e) {}
        if (p && typeof p.then === 'function') {
          p.then(function () { video.pause(); update(); }).catch(function () {});
        }
      }, { passive: true });
    })();
  </script>

  <!-- Slider comparativo antes/depois -->
